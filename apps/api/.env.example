# BranchSuite API configuration. Copy to .env.local for local overrides. Never commit secrets.
# Production values come from Function App settings (managed identity; no keys).

# memory | cosmos
DATA_MODE=memory
COSMOS_ENDPOINT=
COSMOS_DATABASE=branchsuite
# Optional JSON persistence for DATA_MODE=memory
DEV_DATA_FILE=.data/dev.json

# swa | dev  (dev is refused when running in Azure)
AUTH_MODE=dev

# azure | mock
AI_MODE=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Realtime (optional). Leave empty to disable; clients fall back to polling.
WEB_PUBSUB_ENDPOINT=
WEB_PUBSUB_HUB=branchsuite

# Wall key / pairing secret: set ONE of these. KEY_VAULT_URI reads secret "wall-hmac-secret".
WALL_HMAC_SECRET=
KEY_VAULT_URI=

# Comma lists
BOOTSTRAP_ADMIN_EMAILS=
TENANT_DOMAINS=

FEATURE_PIPELINE=true
FEATURE_PERSONAL_MAIL=true
MAIL_ACCESS_HELP=Ask a BranchSuite admin to approve your mailbox for mail intake.

# Whiteboard images (huddle mode). Private Blob container reached with the Function App's managed identity
# (role: Storage Blob Data Contributor on the container). No keys, no SAS, never public.
# Empty: DATA_MODE=memory keeps images in memory (persisted under .data/media when DEV_DATA_FILE is set);
# DATA_MODE=cosmos without an endpoint refuses uploads.
MEDIA_BLOB_ENDPOINT=
MEDIA_CONTAINER=whiteboard-media

# DEV ONLY: on = today's whiteboard takes over wall displays all day (unless a manager sets it to 'off'),
# for testing the huddle takeover locally. Refused unless AUTH_MODE=dev and outside Azure.
DEV_WHITEBOARD_LIVE=
